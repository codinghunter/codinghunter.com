source "https://rubygems.org"

# 构建方式：bundle exec jekyll serve / build
gem "jekyll", "~> 4.4"

# 主题（自带 jekyll-archives / jekyll-paginate / jekyll-sitemap 依赖）
gem "jekyll-whiteglass", "~> 1.11"

# 订阅（RSS）；SEO 标签由主题 head.html + _includes/head_custom.html 负责，
# 因此不引入 jekyll-seo-tag，避免重复输出 meta。
gem "jekyll-feed", "~> 0.17"

# Jekyll 4.3+ 已内置 webrick 依赖，无需再显式声明
